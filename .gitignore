# Dependencies and build output
node_modules/
dist/
dev-dist/
coverage/

# Expo native projects and cache (generated by prebuild)
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/

# Environment: .env.example and apps/web/.env.production are tracked on purpose
.env
.env.local
.env.*.local

# Credentials never belong in git
*.key
*.pem
*.p8
*.p12
*.jks
*.keystore

# Editors and OS
.vscode/
.idea/
.DS_Store
*.log

# Local tool state (regenerable)
.codegraph/
graphify-out/
.mcp.json
.archon/*
!.archon/config.yaml
