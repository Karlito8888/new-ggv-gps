/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Referrer-Policy: strict-origin-when-cross-origin

# The zone injects Cloudflare Web Analytics into proxied HTML, a script the CSP in index.html
# refuses (`script-src 'self'`). `no-transform` stops the injection (developers.cloudflare.com
# /web-analytics/faq/) and also compression, which costs a few KB on this one document.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/tiles/*
  Cache-Control: public, max-age=31536000, immutable
