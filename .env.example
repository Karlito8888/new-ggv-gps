# Variables d'environnement pour MyGGV GPS
# Copier ce fichier vers .env et remplir avec vos vraies valeurs

# ========================================
# CONVEX (REQUIS)
# ========================================
# URL du déploiement Convex (backend MyGGV partagé)
# Dashboard : https://dashboard.convex.dev/t/charles-bourgault/myggv-dev
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ========================================
# ROUTING SERVICES (OPTIONNEL)
# ========================================
# Clé API OpenRouteService (fallback routing niveau 3)
# Obtenir une clé gratuite sur : https://openrouteservice.org/
VITE_OPENROUTE_API_KEY=your_openroute_api_key

# ========================================
# NOTES
# ========================================
# - VITE_CONVEX_URL est REQUIS (données blocks/lots via Convex)
# - VITE_OPENROUTE_API_KEY est optionnel (améliore le routing)
# - L'app fonctionne sans OpenRoute grâce aux fallbacks OSRM et MapLibre
# - Ne jamais commiter le fichier .env avec de vraies clés !
