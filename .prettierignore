# Prettier reads .gitignore itself (its --ignore-path defaults to both files): only what git
# tracks but prettier must not touch belongs here.

# Lockfile and manifests (bun writes them)
package.json
bun.lock

# Editor settings
.vscode/

# Generated / large JSON
apps/web/public/sprites/*.json
apps/mobile/assets/data/

# Tool outputs: each folder carries its own `.gitignore` (`*`), which prettier never reads.
# Without these lines the gate reddens on audit reports and generated HTML.
archon-out/
flow-out/
revue-out/
frise-out/
