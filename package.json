{
  "name": "@ggv/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "gate": "vp check && vp run -r typecheck && vp run -r test && vp run check:sprites",
    "check:sprites": "cmp apps/web/public/sprites/light.png apps/mobile/assets/map/sprites/light-1x.sprite && cmp apps/web/public/sprites/light@2x.png apps/mobile/assets/map/sprites/light-2x.sprite",
    "dev": "vp run --filter @ggv/web dev",
    "build": "vp run --filter @ggv/web build",
    "preview": "vp run --filter @ggv/web preview",
    "snapshot:lots": "vp run --filter @ggv/mobile snapshot:lots",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && vp config --no-agent || true"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "catalog:"
  }
}
