{
  "name": "@ggv/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "gate": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "typecheck": "bun run --filter @ggv/shared typecheck && bun run --filter @ggv/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --filter @ggv/shared test && bun run --filter @ggv/web test",
    "dev": "bun run --filter @ggv/web dev",
    "build": "bun run --filter @ggv/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
